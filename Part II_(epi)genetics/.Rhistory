# OXYTOCIN: group interacting with genotype - including covariates
OXTRlm_fem <- lm(formula = Oxytocin ~ group*rs53576*OXTR_promotor_CpG_average + age + anx_dep_SUM,
data = dfOT_female)
OTAov_fem <- aov(OXTRlm_fem)
summary(OTAov_fem) #  still group (p = 0.0401), grop*genotype (p = 0.0283), and nothing else
perform_correlation_tests <- function(variable, df) {
tests <- list(
CTQ = cor.test(df[[variable]], df$ctq_total, method = "spearman"),
ECR_anx = cor.test(df[[variable]], df$ecr_anx, method = "spearman"),
ECR_av = cor.test(df[[variable]], df$ecr_av, method = "spearman"))
# Extract p-values and correlation coefficients (r)
p_values <- sapply(tests, function(x) x$p.value) # Extract pvalue
r_values <- sapply(tests, function(x) x$estimate)  # Extract correlation coefficient (r)
p_adjusted <- p.adjust(p_values, method = "fdr")  # Adjust p-values
# Store results in a dataframe
results <- data.frame(
Comparison = paste(variable, names(p_values), sep = "_"),
Correlation_Coefficient_r = r_values,
Raw_p_value = p_values,
Adjusted_p_value = p_adjusted)
print(results)
return(results) }
results_Oxytocin <- perform_correlation_tests("Oxytocin", df_OT)
results_intron<- perform_correlation_tests("OXTR_intron_CpG_average", df)
results_promotor <- perform_correlation_tests("OXTR_promotor_CpG_average", df)
