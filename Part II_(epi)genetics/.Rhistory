summary(m2) # adj. R2 = 0.045, p = 0.080
# Model 3: Add rs53576 genotype
m3 <- lm(ias ~ group + Oxytocin +OXTR_intron_CpG_average + rs53576, data = df_OT)
summary(m3) # adj. R2 = 0.041, p = 0.136
anova(m0, m1)  # Does Oxytocin improve prediction? --> no p = 0.1998
anova(m1, m2)  # Does CpG methylation improve prediction? --> no p = 0.4666
anova(m2, m3)  # Does rs53576 improve prediction? --> no, p = 0.4324
library(performance)
compare_performance(m0, m1, m2, m3)
anova(m1, m2)  # Does CpG methylation improve prediction? --> no p = 0.8821
anova(m2, m3)  # Does rs53576 improve prediction? --> no, p = 0.1438
compare_performance(m1, m2, m3)
