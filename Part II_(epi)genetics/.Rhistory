# Create a new binary variable ctq_high
df <- df %>%
mutate(ctq_high = if_else(ctq_total > 35, "high", "low"))
# Load Libraries
library(ISwR)
library(MASS)
library(ggplot2)
library(Hmisc)
library(Hmisc)
library(plotly)
library(readxl)
library(car)
library(lawstat)
library(ggpubr)
library(rstatix)
library(lme4)
library(multcomp)
library(dplyr)
library(tidyverse)
library(tidyverse)
library(dplyr)
library(SNPassoc)
library(tidyverse)
library(dplyr)
library(SNPassoc)
library(ggpubr)
library(corrplot)
library(Hmisc)
library(corrplot)
library(Hmisc)
library(mediation)
library(ggtext)
library(datawizard)
library(gtsummary)
# Create a new binary variable ctq_high
df <- df %>%
mutate(ctq_high = if_else(ctq_total > 35, "high", "low"))
#  INTRON Methyl
df %>%
group_by(ctq_high) %>%
summarise(
mean_oxtr = mean(OXTR_intron_CpG_average, na.rm = TRUE),
sd_oxtr = sd(OXTR_intron_CpG_average, na.rm = TRUE),
n = n() )
stat.test <- df %>%
wilcox_test(OXTR_intron_CpG_average ~ ctq_high) %>%
add_significance()
stat.test # not sig
### separate per site (instead of averaging)
df_introns <- df %>% select(pcode, ctq_high, starts_with("OXTR_intron_CpG_"))
df_long <- df_introns %>%
pivot_longer(
cols = starts_with("OXTR_intron_CpG_"),
names_to = "CpG_site",
values_to = "methylation")
df_long <- df_long %>% mutate( group = factor(ctq_high),CpG_site = factor(CpG_site) )
## stat test
stat_test <- df_long %>%
group_by(CpG_site) %>%
t_test(methylation ~ ctq_high) %>%
adjust_pvalue(method = "fdr") %>%
add_significance()
stat_test
# rename lables
clean_labels <- c(
"OXTR_intron_CpG_2" = "CpG_2",
"OXTR_intron_CpG_5" = "CpG_5",
"OXTR_intron_CpG_6.7" = "CpG_6.7",
"OXTR_intron_CpG_8" = "CpG_8",
"OXTR_intron_CpG_average" = "average")
# show pvalue per site
pval_table <- stat_test %>%
mutate(  CpG_site = recode(CpG_site, !!!clean_labels),
p.adj = signif(p.adj, digits = 3)) %>%
select(CpG_site, p, p.adj) %>%
arrange(CpG_site)
pval_table # non of the sites has sig difference pvalue
sink("3.3_intron_CpG_sites_CTQ.txt")
summary(pval_table)
sink()
#  PROMOTOR Methyl
df %>%
group_by(ctq_high) %>%
summarise(
mean_oxtr = mean(OXTR_promotor_CpG_average, na.rm = TRUE),
sd_oxtr = sd(OXTR_promotor_CpG_average, na.rm = TRUE),
n = n() )
stat.test <- df %>%
wilcox_test(OXTR_promotor_CpG_average ~ ctq_high) %>%
add_significance()
stat.test # not sig
### separate per site (instead of averaging)
df_promotor <- df %>% select(pcode, ctq_high, starts_with("OXTR_promotor_CpG_"))
df_long <- df_promotor %>%
pivot_longer(
cols = starts_with("OXTR_promotor_CpG_"),
names_to = "CpG_site",
values_to = "methylation")
df_long <- df_long %>% mutate( group = factor(ctq_high),CpG_site = factor(CpG_site) )
## stat test
stat_test <- df_long %>%
group_by(CpG_site) %>%
t_test(methylation ~ ctq_high) %>%
adjust_pvalue(method = "fdr") %>%
add_significance()
# rename lables
clean_labels <- c(
"OXTR_promotor_CpG_2" = "CpG_2",
"OXTR_promotor_CpG_3" = "CpG_3",
"OXTR_promotor_CpG_4" = "CpG_4",
"OXTR_promotor_CpG_5.6" = "CpG_5.6",
"OXTR_promotor_CpG_8" = "CpG_8",
"OXTR_promotor_CpG_average" = "average")
# show pvalue per site
pval_table <- stat_test %>%
mutate(  CpG_site = recode(CpG_site, !!!clean_labels),
p.adj = signif(p.adj, digits = 3)) %>%
select(CpG_site, p, p.adj) %>%
arrange(CpG_site)
pval_table # non of the sites has sig difference pvalue
sink("3.3_promotor_CpG_sites_CTQ.txt")
summary(pval_table)
sink()
# Create a new dataset to do sex specific analysis
dfOT_female<-filter(df_OT, sex =="1")
View(df_OT)
### alternative illustration (based on group colors)
# Position adjustments
pd_points <- position_jitterdodge(jitter.width = 0.1, dodge.width = 0.4)
pd_sum    <- position_dodge(width = 0.4)
# Interaction plot
interaction_plot <- df_OT |>
mutate(group = factor(group, levels = c(0, 1), labels = c("HC", "FND"))) |>
ggplot(aes(x = group,   y = Oxytocin,   color = group)) +
geom_point(position = pd_points,  size = 2,  alpha = 0.5) +
# Summary lines by genotype (linetype distinguishes rs53576)
geom_line(
data = oxytocin_summary,
aes(x = group, y = mean, group = rs53576,linetype = rs53576),
position = pd_sum, linewidth = 1.0, inherit.aes = FALSE) +
geom_point(data = oxytocin_summary,
aes(x = group, y = mean, linetype = rs53576),
position = pd_sum, size = 3, shape = 16, inherit.aes = FALSE) +
geom_errorbar( data = oxytocin_summary,
aes( x = group, ymin = mean - ci,  ymax = mean + ci,  linetype = rs53576),
position = pd_sum, width = 0.1,  linewidth = 0.6,  inherit.aes = FALSE  ) +
# Manual color scale for HC/FND
scale_color_manual( values = c("HC"  = "#868686FF", "FND" = "#BB4038"  )) +
labs( title = expression(italic("OXTR") ~ "Genotype × Group Interaction on Oxytocin"),
x     = "Group",
y     = "Salivary Oxytocin [pg/ml]",
color = "Group",
linetype = "rs53576 Genotype" ) +
theme_classic(base_size = 13) +
theme(
plot.title   = element_text(size = 14, face = "bold", hjust = 0.5),
axis.title   = element_text(size = 12),
axis.text    = element_text(size = 10),
legend.title = element_text(size = 12, face = "bold"),
legend.text  = element_text(size = 11) )
interaction_plot
